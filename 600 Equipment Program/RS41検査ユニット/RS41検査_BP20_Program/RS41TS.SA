    10 !RS41通信プログラム
    20 OPTION BASE 1
    30 DEFINT A-Z
    40 COM #S1 RDATA(2) :!SP28 R0001-R0002
    50 COM #S2 WDATA(2) :!BP20 R0003-R0004
    60 NEWL
    70 !======================================================================
    80 DIM@ !            ＤＩＭ宣言
    90 !======================================================================
   100      DIM P1OUT$128
   110      DIM RS41TXT$128        :! RS41 Receive buffer
   120 NEWL
   130 !==========================================================
   140 INIT@
   150 !==========================================================
   160      RS41   =6
   170      PORT1  =1
   180      RSTIMER=10000     :!RS-232-C timer     (=10sec)
   190      P1OUT$ ="YOKOGAWA"
   200      CRLF$  =CHR$($0D)+CHR$($0A)
   210      ASSIGN SP28=1
   220 NEWL
   230 !======================================================================
   240 MAIN@ !           MAIN ROUTINE
   250 !======================================================================
   260          WDATA(1)=0  :!共有レジスタ初期化
   270          WAIT 100
   280 L1@
   290         !  SP28の共有レジスタへ1の入力待ち
   300          IF RDATA(1)<>1 THEN GOTO L1@
   310 DP RDATA(1)
   320         !RS41初期化
   330          GOSUB ASS@
   340          GOSUB RSINT41@
   350         !RS41--->RZ91-0F
   360          ON TIMER #1,RSTIMER GOTO TMOVER@
   370          OUTPUT RS41,PORT1;P1OUT$
   380          WAIT 100
   390 !
   400         !RZ91-0F----->RS41
   410 L2@
   420          RS41TXT$=""
   430         !RZ91からのデータ送信待ち
   440          ENTER RS41,PORT1;RS41TXT$
   450 DP RS41TXT$
   460 DP P1OUT$
   470          IF RS41TXT$<>P1OUT$+CRLF$ THEN GOTO L2@
   480          OFF TIMER #1
   490          WDATA(1)=2    :!共有レジスタに2(TEST OK)
   500          WAIT 5000       :!5sec後にMAINに戻りWDATA(1)は0にする
   510          GOTO MAIN@
   520 !======================================================================
   530 !                 サブ・ル－チン群
   540 !======================================================================
   550 !----------------------------------------------------------------------
   560 ASS@      !       CARD ASSIGN
   570 !----------------------------------------------------------------------
   580           ON ERROR GOTO ASSERR@
   590           ASSIGN RS41=RS41
   600           OFF ERROR
   610 RETURN
   620 !----------------------------------------------------------------------
   630 RSINT41@  !       RS41 INITIALIZE
   640 !----------------------------------------------------------------------
   650           RESET RS41
   660           CONTROL RS41,PORT1, 6;1         :! ASCII
   670           CONTROL RS41,PORT1,11;1         :! 8
   680           CONTROL RS41,PORT1,12;0         :! 0 STOP
   690           CONTROL RS41,PORT1,13;0         :! NON PARITY
   700           CONTROL RS41,PORT1,14;8         :! 19200BPS
   710           CONTROL RS41,PORT1,15;1         :! 2 LINE
   720           CONTROL RS41,PORT1,16;0         :! 2 LINE
   730 !          CONTROL RS41,PORT1,22;$000A
   740 !          CONTROL RS41,PORT1,23;128
   750           RESET RS41,PORT1,1
   760 RETURN
   770 NEWL
   780 !======================================================================
   790 ERROR@    !       エラ－処理・ル－チン
   800 !======================================================================
   810 ASSERR@   ! assign error
   820 TMOVER@   ! タイムアウト
   830 CMPERR@   ! コンペア  エラ－
   840 TSTNG@
   850           GOTO MAIN@
   860 NEWL
   870 !======================================================================
   880 END@ !            終了処理
   890 !======================================================================
   900 END
